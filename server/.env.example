PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/mediqo
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated web panel origins, e.g. https://mediqo-admin.vercel.app
CORS_ORIGINS=http://localhost:3000

# Claude (symptom assistant + triage)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Web panel browser push: generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mediqo.app

# Minutes before a confirmed visit to send the "starts soon" reminder
REMINDER_LEAD_MINUTES=60

# Protects GET /api/cron/reminders (Vercel). The scheduler sends `Authorization: Bearer <CRON_SECRET>`.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
