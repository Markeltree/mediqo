NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Google Maps location picker on the register / facility pages.
# Enable "Maps JavaScript API" and "Places API (New)", and restrict the key to your admin domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud (Map Management); DEMO_MAP_ID is used when empty
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
