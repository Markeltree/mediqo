# Your machine's LAN IP when testing on a phone, e.g. http://192.168.1.20:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Google Maps (Google Cloud Console → enable "Maps SDK for Android" / "Maps SDK for iOS")
# One key for both works; the platform-specific ones override it.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# EAS builds: run `npx eas init` and paste the project id
EAS_PROJECT_ID=
